<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_reminder_brownielab.PaymentReminderPopup">
        <div class="popup o_brownielab_payment_reminder_popup">
            <div class="modal-header">
                <h4 class="modal-title title" t-att-style="this.titleStyle">
                    <t t-esc="props.title"/>
                </h4>
            </div>
            <main class="body modal-body text-center" t-att-style="this.bodyStyle">
                <div
                    class="o_brownielab_payment_reminder_line"
                    t-att-style="this.lineStyle"
                    t-foreach="props.lines"
                    t-as="line"
                    t-key="line"
                >
                    <t t-esc="line"/>
                </div>
            </main>
            <footer class="footer modal-footer justify-content-center">
                <div
                    class="button confirm highlight btn btn-primary"
                    t-att-style="this.buttonStyle"
                    t-on-click="confirm"
                >
                    <t t-esc="props.confirmText"/>
                </div>
            </footer>
        </div>
    </t>
</templates>
