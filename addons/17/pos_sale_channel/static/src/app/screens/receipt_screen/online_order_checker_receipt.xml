<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_sale_channel.ReceiptScreenOnlineCheckerButton" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('buttons')]" position="after">
            <div class="buttons my-3" t-if="shouldShowOnlineCheckerButton()">
                <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="openOnlineOrderChecker">
                    <i class="fa fa-check-square-o me-2"/>
                    <t t-esc="getOnlineCheckerReceiptButtonLabel()"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
