<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_sale_channel.OnlineOrderCheckerScreen" owl="1">
        <div class="screen d-flex flex-column gap-3 p-3 bg-light">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="mb-1">Online Order Checker</h2>
                    <div class="text-muted" t-if="state.orderName">
                        <strong t-esc="state.orderName"/>
                        <t t-if="state.saleChannelName"> | <t t-esc="state.saleChannelName"/></t>
                        <t t-if="state.partnerName"> | <t t-esc="state.partnerName"/></t>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge fs-6" t-att-class="statusBadgeClass" t-esc="state.onlineCheckStatus"/>
                    <button class="btn btn-outline-secondary" t-on-click="back">Back</button>
                </div>
            </div>

            <div t-if="state.isLoading" class="alert alert-info mb-0">
                Loading checker data...
            </div>

            <div t-elif="!state.orderId" class="alert alert-danger mb-0">
                Order reference is not available for the online checker.
            </div>

            <t t-else="">
                <div class="card shadow-sm">
                    <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">Progress</div>
                            <div class="text-muted" t-esc="currentProgressDisplay"/>
                        </div>
                        <div t-if="state.onlineCheckOverrideReason" class="text-danger fw-semibold">
                            Override reason: <t t-esc="state.onlineCheckOverrideReason"/>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <label class="form-label fw-semibold mb-1">Pickup / Driver Note</label>
                        <textarea
                            class="form-control"
                            rows="3"
                            t-att-readonly="!canEdit ? true : undefined"
                            t-model="state.onlineCheckNote"
                        ></textarea>
                    </div>
                </div>

                <div class="card shadow-sm flex-grow-1">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-center">Ordered</th>
                                        <th class="text-center">Checked</th>
                                        <th class="text-center">Remaining</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-if="!state.lines.length">
                                        <td colspan="6" class="text-center text-muted py-4">
                                            No order lines require the online checker.
                                        </td>
                                    </tr>
                                    <tr t-foreach="state.lines" t-as="line" t-key="line.line_id">
                                        <td>
                                            <div class="fw-semibold" t-esc="line.product_name"/>
                                            <div class="text-muted small" t-if="line.sale_channel_name" t-esc="line.sale_channel_name"/>
                                        </td>
                                        <td class="text-center" t-esc="formatQty(line.ordered_qty)"/>
                                        <td class="text-center" t-esc="formatQty(line.checked_qty)"/>
                                        <td class="text-center" t-esc="formatQty(line.remaining_qty)"/>
                                        <td class="text-center text-capitalize" t-esc="line.status"/>
                                        <td class="text-end">
                                            <div class="btn-group" t-if="canEdit">
                                                <button class="btn btn-outline-primary btn-sm" t-att-data-line-id="line.line_id" t-on-click="onIncrementLine">+1</button>
                                                <button class="btn btn-outline-success btn-sm" t-att-data-line-id="line.line_id" t-on-click="onSetLineFull">Set Full</button>
                                                <button class="btn btn-outline-secondary btn-sm" t-att-data-line-id="line.line_id" t-on-click="onResetLine">Reset</button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <button
                        t-if="canEdit"
                        class="btn btn-outline-primary"
                        t-on-click="saveProgress"
                    >
                        Save Progress
                    </button>
                    <button
                        t-if="canEdit"
                        class="btn btn-success"
                        t-on-click="completeChecker"
                        t-att-disabled="!isFullyMatched ? true : undefined"
                    >
                        Complete Checker
                    </button>
                    <button
                        t-if="canEdit and state.onlineCheckCanManage"
                        class="btn btn-danger"
                        t-on-click="overrideChecker"
                    >
                        Override &amp; Complete
                    </button>
                    <button
                        t-if="!canEdit and state.onlineCheckCanManage"
                        class="btn btn-warning"
                        t-on-click="reopenChecker"
                    >
                        Reopen Checker
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
