<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_online_checker" model="ir.ui.view">
        <field name="name">pos.config.form.online.checker</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group string="Online Order Checker">
                    <field
                        name="online_checker_channel_ids"
                        widget="many2many_tags"
                        options="{'no_create_edit': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
