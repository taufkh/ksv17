<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_backend_sale_channel_revision_wizard_form" model="ir.ui.view">
        <field name="name">pos.backend.sale.channel.revision.wizard.form</field>
        <field name="model">pos.backend.sale.channel.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Revise Sales Channel">
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="current_sale_channel_id"/>
                        <field name="available_sale_channel_ids" invisible="1"/>
                        <field name="new_sale_channel_id"/>
                    </group>
                    <group>
                        <field
                            name="reason"
                            placeholder="Explain why this sales channel correction is needed..."
                            required="1"
                        />
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_revision" string="Apply Revision" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pos_order_form_inherit_sale_channel_revision" model="ir.ui.view">
        <field name="name">pos.order.form.sale.channel.revision</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_backend_sale_channel_revision_wizard"
                    string="Revise Sales Channel"
                    type="object"
                    groups="bakery_user_roles.group_bakery_finance"
                    invisible="state not in ('paid', 'done', 'invoiced')"
                />
            </xpath>
        </field>
    </record>
</odoo>
