<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_change_log_tree" model="ir.ui.view">
        <field name="name">pos.payment.method.change.log.tree</field>
        <field name="model">pos.payment.method.change.log</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="change_datetime"/>
                <field name="order_id"/>
                <field name="session_id"/>
                <field name="old_payment_method_id"/>
                <field name="new_payment_method_id"/>
                <field name="payment_amount"/>
                <field name="executed_by_id"/>
                <field name="used_pin_masked"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_payment_method_change_log_form" model="ir.ui.view">
        <field name="name">pos.payment.method.change.log.form</field>
        <field name="model">pos.payment.method.change.log</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="session_id"/>
                        <field name="company_id"/>
                        <field name="change_datetime"/>
                        <field name="executed_by_id"/>
                    </group>
                    <group>
                        <field name="old_payment_method_id"/>
                        <field name="new_payment_method_id"/>
                        <field name="payment_amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="used_pin_masked"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
