<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_backend_void_order_wizard_form" model="ir.ui.view">
        <field name="name">pos.backend.void.order.wizard.form</field>
        <field name="model">pos.backend.void.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Void Order">
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="company_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_total"/>
                    </group>
                    <group>
                        <field name="payment_snapshot" widget="text" readonly="1"/>
                    </group>
                    <group>
                        <field name="reason" placeholder="Explain why this POS order must be voided..." required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_void" string="Void Order" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pos_order_form_inherit_void_order" model="ir.ui.view">
        <field name="name">pos.order.form.void.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_backend_void_wizard"
                    string="Void Order"
                    type="object"
                    groups="bakery_user_roles.group_bakery_finance"
                    invisible="state not in ('paid', 'done', 'invoiced') or is_voided"
                />
                <button
                    name="action_view_void_refund_order"
                    string="View Void Refund"
                    type="object"
                    groups="bakery_user_roles.group_bakery_finance"
                    invisible="not void_refund_order_id"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="void_audit" string="Void Audit" groups="bakery_user_roles.group_bakery_finance">
                    <group>
                        <group>
                            <field name="is_voided"/>
                            <field name="voided_at"/>
                            <field name="voided_by_id"/>
                        </group>
                        <group>
                            <field name="void_refund_order_id"/>
                            <field name="void_origin_order_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="void_reason" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
