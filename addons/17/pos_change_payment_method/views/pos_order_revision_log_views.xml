<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_revision_logs" model="ir.ui.view">
        <field name="name">pos.order.form.revision.logs</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="revision_logs" string="Revision Logs">
                    <field name="revision_change_log_ids" readonly="1">
                        <tree create="0" delete="0" edit="0">
                            <field name="change_datetime"/>
                            <field name="change_type"/>
                            <field name="change_origin"/>
                            <field name="original_cashier_id"/>
                            <field name="related_order_id"/>
                            <field name="old_value_display"/>
                            <field name="new_value_display"/>
                            <field name="payment_amount"/>
                            <field name="policy_status"/>
                            <field name="executed_by_id"/>
                            <field name="change_reason"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
