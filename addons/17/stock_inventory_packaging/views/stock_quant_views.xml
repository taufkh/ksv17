<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_packaging" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.editable.packaging</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field
                    name="on_hand_pack_qty"
                    string="On Hand Pack Qty"
                    readonly="1"
                    invisible="not inventory_packaging_id"
                />
            </field>
            <field name="product_uom_id" position="after">
                <field
                    name="inventory_packaging_id"
                    string="Count Pack"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field
                    name="inventory_pack_qty"
                    string="Counted Pack Qty"
                    invisible="not inventory_packaging_id"
                />
            </field>
            <field name="inventory_quantity" position="replace">
                <field
                    name="inventory_quantity_display"
                    string="Converted Quantity"
                    widget="counted_quantity_widget"
                    on_change="1"
                    invisible="inventory_packaging_id"
                />
                <field
                    name="inventory_quantity_pack_display"
                    string="Converted Quantity"
                    readonly="1"
                    invisible="not inventory_packaging_id"
                />
            </field>
        </field>
    </record>
</odoo>
