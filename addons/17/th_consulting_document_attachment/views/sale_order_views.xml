<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_document_attachment" model="ir.ui.view">
        <field name="name">sale.order.form.document.attachment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Lampiran" name="image_attachments">
                    <field name="image_attachment_ids" nolabel="1" context="{'default_sale_order_id': id}">
                        <tree editable="bottom" default_order="sequence, id">
                            <field name="sale_order_id" column_invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field
                                name="sale_order_line_id"
                                domain="[('order_id', '=', sale_order_id), ('display_type', '=', False)]"
                                options="{'no_create': True}"
                            />
                            <field name="description" optional="hide"/>
                            <field name="report_layout" readonly="1" optional="hide"/>
                            <field name="image" widget="image" options="{'size': [90, 90]}"/>
                        </tree>
                        <form string="Lampiran">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="sale_order_id" invisible="1"/>
                                        <field name="sequence"/>
                                        <field
                                            name="sale_order_line_id"
                                            domain="[('order_id', '=', sale_order_id), ('display_type', '=', False)]"
                                            options="{'no_create': True}"
                                        />
                                        <field name="report_layout" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="image" widget="image"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="description" placeholder="Keterangan tambahan untuk lampiran ini"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_quote_inherit_document_attachment" model="ir.ui.view">
        <field name="name">sale.order.form.quote.document.attachment</field>
        <field name="model">sale.order</field>
        <field name="active" eval="False"/>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <page name="optional_products" position="after">
                <page string="Lampiran" name="image_attachments_quote" invisible="state not in ['draft', 'sent']">
                    <field name="image_attachment_ids" nolabel="1" context="{'default_sale_order_id': id}">
                        <tree editable="bottom" default_order="sequence, id">
                            <field name="sale_order_id" column_invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field
                                name="sale_order_line_id"
                                domain="[('order_id', '=', sale_order_id), ('display_type', '=', False)]"
                                options="{'no_create': True}"
                            />
                            <field name="description" optional="hide"/>
                            <field name="report_layout" readonly="1" optional="hide"/>
                            <field name="image" widget="image" options="{'size': [90, 90]}"/>
                        </tree>
                        <form string="Lampiran">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="sale_order_id" invisible="1"/>
                                        <field name="sequence"/>
                                        <field
                                            name="sale_order_line_id"
                                            domain="[('order_id', '=', sale_order_id), ('display_type', '=', False)]"
                                            options="{'no_create': True}"
                                        />
                                        <field name="report_layout" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="image" widget="image"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="description" placeholder="Keterangan tambahan untuk lampiran ini"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
