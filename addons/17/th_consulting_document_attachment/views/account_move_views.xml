<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_document_attachment" model="ir.ui.view">
        <field name="name">account.move.form.document.attachment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Lampiran" name="image_attachments">
                    <field name="image_attachment_ids" nolabel="1" context="{'default_move_id': id}">
                        <tree editable="bottom" default_order="sequence, id">
                            <field name="move_id" column_invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field
                                name="move_line_id"
                                domain="[('move_id', '=', move_id), ('display_type', '=', False)]"
                                options="{'no_create': True}"
                            />
                            <field name="description" optional="hide"/>
                            <field name="report_layout" readonly="1" optional="hide"/>
                            <field name="image" widget="image" options="{'size': [90, 90]}"/>
                        </tree>
                        <form string="Lampiran">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="move_id" invisible="1"/>
                                        <field name="sequence"/>
                                        <field
                                            name="move_line_id"
                                            domain="[('move_id', '=', move_id), ('display_type', '=', False)]"
                                            options="{'no_create': True}"
                                        />
                                        <field name="report_layout" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="image" widget="image"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="description" placeholder="Keterangan tambahan untuk lampiran ini"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
