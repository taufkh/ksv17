<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_brownielab_stock_count_import_wizard_form" model="ir.ui.view">
        <field name="name">brownielab.stock.count.import.wizard.form</field>
        <field name="model">brownielab.stock.count.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Stock Count">
                <sheet>
                    <group>
                        <group>
                            <field name="location_id" />
                            <field name="inventory_date" />
                            <field name="apply_immediately" />
                        </group>
                        <group>
                            <field name="upload_file" filename="upload_filename" />
                            <field name="upload_filename" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="template_notes"
                            nolabel="1"
                            readonly="1"
                            widget="text"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_download_template"
                        string="Download Template"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_import_file"
                        string="Import Count"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_brownielab_stock_count_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Stock Count</field>
        <field name="res_model">brownielab.stock.count.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
