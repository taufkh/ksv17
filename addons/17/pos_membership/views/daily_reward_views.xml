<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_free_product_config_tree" model="ir.ui.view">
        <field name="name">daily.free.product.config.tree</field>
        <field name="model">daily.free.product.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_mode"/>
                <field name="date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id"/>
                <field name="reward_product_names"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_daily_free_product_config_form" model="ir.ui.view">
        <field name="name">daily.free.product.config.form</field>
        <field name="model">daily.free.product.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date_mode"/>
                        <field name="date" invisible="date_mode != 'single_date'"/>
                        <field name="date_start" invisible="date_mode != 'date_range'"/>
                        <field name="date_end" invisible="date_mode != 'date_range'"/>
                        <field name="company_id"/>
                        <field name="reward_product_ids" string="Reward Products">
                            <tree>
                                <field name="display_name" string="Product"/>
                            </tree>
                        </field>
                        <field name="product_id" invisible="1"/>
                        <field name="product_tmpl_id" readonly="1" invisible="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_daily_free_product_config" model="ir.actions.act_window">
        <field name="name">Daily Reward Config</field>
        <field name="res_model">daily.free.product.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_daily_claim_log_tree" model="ir.ui.view">
        <field name="name">daily.claim.log.tree</field>
        <field name="model">daily.claim.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="pos_order_id"/>
            </tree>
        </field>
    </record>

    <record id="action_daily_claim_log" model="ir.actions.act_window">
        <field name="name">Daily Claim Logs</field>
        <field name="res_model">daily.claim.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_daily_free_product_config"
        name="Daily Reward Config"
        parent="menu_pos_membership_root"
        action="action_daily_free_product_config"
        sequence="30"
    />
    <menuitem
        id="menu_daily_claim_log"
        name="Daily Claim Logs"
        parent="menu_pos_membership_root"
        action="action_daily_claim_log"
        sequence="40"
    />
</odoo>
